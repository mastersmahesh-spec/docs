# ═══════════════════════════════════════════════════════════════
# 7. EXECUTE SINGLE REPORT
# ═══════════════════════════════════════════════════════════════
def execute_report(query_id, report_name, group_name, hour_label):
    global fired_count, error_count

    report = REPORTS.get(report_name)
    if not report:
        return

    sample = random.sample(acct_rtg_list, min(ACCOUNTS_PER_CALL, len(acct_rtg_list)))
    start  = time.time()
    status = "SUCCESS"
    rows   = []
    metrics_dict = {}
    phase_dict   = {}

    try:
        result = cluster.query(
            f"EXECUTE {report['statement']}",
            QueryOptions(
                named_parameters=report["params"](sample),
                profile=QueryProfile.PHASES
            )
        )
        rows = list(result)

        meta    = result.metadata()
        metrics = meta.metrics()
        profile = meta.profile() or {}

        metrics_dict = {
            "elapsed_ms"   : timedelta_to_ms(metrics.elapsed_time()),
            "execution_ms" : timedelta_to_ms(metrics.execution_time()),
            "result_count" : int(metrics.result_count()),
            "payload_kb"   : round(int(metrics.result_size()) / 1024, 3),
            "error_count"  : int(metrics.error_count()),
            "sort_count"   : int(metrics.sort_count()),
        }

        phase_times  = profile.get("phaseTimes",  {})
        phase_counts = profile.get("phaseCounts", {})

        phase_dict = {
            "phase_authorize_ms"  : _to_ms(phase_times.get("authorize")),
            "phase_parse_ms"      : _to_ms(phase_times.get("parse")),
            "phase_plan_ms"       : _to_ms(phase_times.get("plan")),
            "phase_index_scan_ms" : _to_ms(phase_times.get("indexScan")),
            "phase_fetch_ms"      : _to_ms(phase_times.get("fetch")),
            "phase_filter_ms"     : _to_ms(phase_times.get("filter")),
            "phase_project_ms"    : _to_ms(phase_times.get("project")),
            "phase_stream_ms"     : _to_ms(phase_times.get("stream")),
            "count_index_scan"    : phase_counts.get("indexScan"),
            "count_fetch"         : phase_counts.get("fetch"),
            "count_project"       : phase_counts.get("project"),
        }

    except Exception as e:
        status = f"ERROR: {str(e)[:150]}"
        with error_lock:
            error_count += 1

    wall_sec = round(time.time() - start, 6)

    with lock:
        all_rows.append({
            # Identity
            "query_id"   : query_id,
            "hour"       : hour_label,
            "group"      : group_name,
            "report"     : report_name,
            "statement"  : report["statement"],
            "timestamp"  : datetime.now().isoformat(),
            "status"     : status,
            "wall_sec"   : wall_sec,
            "accounts"   : sample,
            # Metrics
            **metrics_dict,
            # Phase timings
            **phase_dict,
            # Actual rows
            "rows"       : rows
        })

    with fired_lock:
        fired_count += 1

# ═══════════════════════════════════════════════════════════════
# 8. HOURLY WAVE RUNNER (rate-controlled)
# ═══════════════════════════════════════════════════════════════
def run_hour_wave(hour_label, config, weights):
    target_rps   = config["target_rps"]
    total_calls  = config["total_calls"]
    duration_sec = config["duration_min"] * 60
    interval     = 1.0 / target_rps   # seconds between launches
    MAX_CONCURRENT = 20                # semaphore cap

    print(f"\n{'='*65}")
    print(f"  Hour         : {hour_label}:00")
    print(f"  Target calls : {total_calls:,}")
    print(f"  Target RPS   : {target_rps}")
    print(f"  Interval     : {round(interval, 3)}s between launches")
    print(f"  Max concurrent: {MAX_CONCURRENT} threads")
    print(f"{'='*65}")

    semaphore   = threading.Semaphore(MAX_CONCURRENT)
    hour_fired  = 0
    hour_start  = time.time()
    threads     = []

    def fire(query_id, report_name, group_name):
        with semaphore:
            execute_report(query_id, report_name, group_name, hour_label)

    while hour_fired < total_calls and (time.time() - hour_start) < duration_sec:
        report_name, group_name = pick_report(weights)
        t = threading.Thread(
            target=fire,
            args=(hour_fired, report_name, group_name)
        )
        t.start()
        threads.append(t)
        hour_fired += 1

        # Pace launches to hit target RPS
        next_launch = hour_start + (hour_fired * interval)
        sleep_time  = next_launch - time.time()
        if sleep_time > 0:
            time.sleep(sleep_time)

        # Progress print every 1000 queries
        if hour_fired % 1000 == 0:
            elapsed    = round(time.time() - hour_start, 1)
            actual_rps = round(hour_fired / elapsed, 2) if elapsed > 0 else 0
            print(f"  [{hour_label}:00] Fired: {hour_fired:,}/{total_calls:,} | "
                  f"Elapsed: {elapsed}s | Actual RPS: {actual_rps} | "
                  f"Errors: {error_count}")

    # Wait for all threads to complete
    for t in threads:
        t.join()

    hour_elapsed    = round(time.time() - hour_start, 2)
    hour_actual_rps = round(hour_fired / hour_elapsed, 2)
    print(f"  [{hour_label}:00] DONE — {hour_fired:,} queries | "
          f"{hour_elapsed}s | {hour_actual_rps} actual RPS")


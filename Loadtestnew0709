# 5. HELPERS
# ═══════════════════════════════════════════════════════════════
def timedelta_to_ms(td):
    return round(td.total_seconds() * 1000, 3) if td else None

def _to_ms(duration_str):
    if not duration_str:
        return None
    try:
        if duration_str.endswith("ms"):
            return round(float(duration_str[:-2]), 3)
        elif duration_str.endswith("us"):
            return round(float(duration_str[:-2]) / 1000, 3)
        elif duration_str.endswith("s") and not duration_str.endswith("ms"):
            return round(float(duration_str[:-1]) * 1000, 3)
        elif duration_str.endswith("ns"):
            return round(float(duration_str[:-2]) / 1_000_000, 3)
    except:
        return None

def pick_report(weights):
    groups       = [g for g, w in weights.items() if REPORT_GROUPS.get(g)]
    group_wts    = [weights[g] for g in groups]
    chosen_group = random.choices(groups, weights=group_wts, k=1)[0]
    return random.choice(REPORT_GROUPS[chosen_group]), chosen_group

